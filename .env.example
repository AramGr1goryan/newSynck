# Contact Service Configuration
# Replace with actual credentials in production environment

CONTACT_PROVIDER=unconfigured

# Email Settings
CONTACT_FROM_EMAIL=no-reply@project-synck.example.com
CONTACT_TO_EMAIL=hello@project-synck.example.com

# Provider Credentials (e.g., Resend, SendGrid, etc.)
CONTACT_API_KEY=your_api_key_here

# Webhook (If using CRM integration instead of email)
CONTACT_WEBHOOK_URL=https://hooks.example.com/v1/contact
